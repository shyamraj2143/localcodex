{
    "execution_mode": "offline",
    "provider": "ollama",
    "ui_mode": "auto",
    "dashboard_demo_mode": true,
    "dashboard_language": "hinglish",
    "dashboard_show_technical": false,
    "local_model": "qwen2.5-coder:3b",
    "startup_local_model_options": [
        "qwen2.5-coder:3b",
        "deepseek-coder:1.3b"
    ],
    "ollama_base_url": "http://localhost:11434/v1",
    "models": {
        "planner": "openai/gpt-oss-120b",
        "coder": "qwen/qwen3.8-27b",
        "fast": "openai/gpt-oss-20b",
        "debugger": "minimaxai/minimax-m2.7",
        "reviewer": "openai/gpt-oss-120b"
    },
    "max_parallel_tool_workers": 2,
    "max_concurrent_llm_requests": 1,
    "max_total_workers": 3,
    "max_agent_steps": 32,
    "task_deadline_seconds": 300,
    "workspace_context_chars": 6500,
    "temperature": 0.1,
    "max_tokens": 8192,
    "retry": {
        "max_attempts": 2,
        "base_delay": 1.5
    },
    "nvidia_model": "openai/gpt-oss-20b",
    "nvidia_base_url": "https://integrate.api.nvidia.com/v1",
    "nvidia_request_timeout_seconds": 45,
    "task_architect_enabled": true,
    "architect_provider": "auto",
    "hosted_provider_preference": "auto",
    "provider_fallback_enabled": false,
    "hosted_api_enabled": true,
    "local_only": true,
    "hosted_coder_escalation": false,
    "escalation_provider": "auto",
    "max_escalations": 1,
    "request_timeout_seconds": 90,
    "persistent_memory_enabled": true,
    "training_data_collection_enabled": true,
    "workspace_memory_dir": ".localcodex/memory",
    "workspace_memory_context_chars": 1200
}
